PORT=3001
NODE_ENV=development

# Database local (coincide con backend/mysql/docker-compose.yml)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=spellnet

# JWT (genera un valor aleatorio nuevo para tu .env local)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Ollama (modelo de chat)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# ChromaDB y embeddings RAG
CHROMA_URL=http://localhost:8000

# Uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.pdf,.txt,.md

# External APIs (opcionales)
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

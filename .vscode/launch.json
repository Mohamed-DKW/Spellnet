{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development",
        "OLLAMA_HOST": "http://127.0.0.1:11434",
        "CHROMA_URL": "http://127.0.0.1:8000"
      }
    },
    {
      "name": "Frontend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development",
        "VITE_API_URL": "http://127.0.0.1:3001"
      }
    },
    {
      "name": "Ingest Script",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/scripts/ingest.ts",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ts-node", "scripts/ingest.ts"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Chat Script",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/scripts/chat.ts",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ts-node", "scripts/chat.ts"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Frontend Chrome",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Start App",
      "configurations": ["Backend", "Frontend"],
      "stopAll": true,
      "preLaunchTask": "Wait For Ollama"
    },
    {
      "name": "Debug Full Stack",
      "configurations": ["Backend", "Frontend", "Frontend Chrome"],
      "stopAll": true,
      "preLaunchTask": "Wait For Ollama"
    }
  ]
}